{
  "name": "emitter-js",
  "description": "A modern event emitter implementation.",
  "version": "2.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffrose/emitter.git"
  },
  "homepage": "https://github.com/jeffrose/emitter",
  "bugs": "https://github.com/jeffrose/emitter/issues",
  "author": "Jeff Rose <jeff_rose@outlook.com> (http://github.com/jeffrose)",
  "license": "MIT",
  "keywords": [
    "emitter",
    "eventemitter",
    "event",
    "events",
    "es6",
    "es2015"
  ],
  "main": "index.js",
  "files": [
    "docs",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:unit",
    "test:unit": "mocha",
    "test:src": "mocha --ignore test/dist.test.mjs",
    "coverage": "npm run build && c8 mocha",
    "benchmark": "node test/benchmark.mjs",
    "trace": "node --allow-natives-syntax test/trace.mjs",
    "prepublishOnly": "npm run lint && npm run format:check && npm test && npm run build:docs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-modules-umd": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "benchmark": "^2.1.4",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "chalk": "^6.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdoc-to-markdown": "^9.1.3",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "c8": {
    "include": [
      "src/**"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "scripts/**"
    ],
    "reporter": [
      "text"
    ]
  }
}
